<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies to every build variant (debug, profile, release) — permits
  cleartext (http://, not https://) traffic to the local Django dev server
  only. Android blocks cleartext traffic by default for apps targeting API
  28+ (this app's targetSdk is 36), so without this, every http:// request
  to the dev backend fails immediately with a connection error — this must
  be in `src/main/`, not `src/debug/`, or a "release" APK sideloaded for
  testing against the same dev backend fails while `flutter run` (debug)
  works, since a debug-only config never merges into a release build.

  Keep this list of domains in sync with env_config.dart's possible
  EnvConfig.apiBaseUrl hosts (10.0.2.2 for the Android emulator, plus
  whichever LAN IP EnvConfig._developmentLanIp is currently set to). Once a
  real production backend is wired up over HTTPS (see
  EnvConfig.productionApiUrl), this config has no effect on it — cleartext
  exceptions only apply to the specific http:// domains listed below.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Development machine's current LAN IP — update alongside
             EnvConfig._developmentLanIp whenever it changes. -->
        <domain includeSubdomains="false">192.168.170.202</domain>
    </domain-config>
</network-security-config>
